# Copia este archivo a .env y ajusta los valores.
# Backend: URL completa con protocolo, puerto y, opcionalmente, ruta base.
BACKEND_URL=http://localhost:8000
API_URL=http://localhost:8000

# Frontend: puerto e interfaz donde escucha `npm run dev` / `npm run start`.
FE_PORT=3000
# FE_HOST=0.0.0.0


